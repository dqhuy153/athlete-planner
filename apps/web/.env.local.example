# apps/web — Copy to .env.local and fill in values
# All variables marked REQUIRED must be set before the app will start.

# ─── Public (inlined at build time, safe for browser) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001        # REQUIRED: URL of the NestJS API
NEXT_PUBLIC_SITE_URL=http://localhost:3000       # REQUIRED: URL of this web app

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000               # REQUIRED: Must match NEXT_PUBLIC_SITE_URL
NEXTAUTH_SECRET=change-me-nextauth-secret        # REQUIRED: min 16 chars, generate with: openssl rand -base64 32

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                                # REQUIRED: From Google Cloud Console
GOOGLE_CLIENT_SECRET=                            # REQUIRED: From Google Cloud Console
