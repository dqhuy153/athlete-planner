# apps/web — Copy to .env.local and fill in values.
# All variables marked REQUIRED must be set before the app will start.
#
# For local dev without real Google credentials:
#   Leave GOOGLE_CLIENT_ID/SECRET as "dev-placeholder" — the app starts
#   but Google OAuth login will fail until real values are set.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Public (inlined at build time, safe for browser) ────────────────────────
# REQUIRED: URL of the NestJS API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# REQUIRED: Public URL of this web app (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# REQUIRED: Must match NEXT_PUBLIC_SITE_URL exactly
NEXTAUTH_URL=http://localhost:3000

# REQUIRED: min 16 chars. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-nextauth-secret-min-16-chars

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# REQUIRED: Get from Google Cloud Console → APIs & Services → Credentials
# See docs/deployment.md — "Google OAuth Setup" section.
# Use "dev-placeholder" locally to allow the app to start without real creds.
GOOGLE_CLIENT_ID=dev-placeholder
GOOGLE_CLIENT_SECRET=dev-placeholder
