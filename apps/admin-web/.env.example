# apps/admin-web — Copy to .env.local and fill in values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Public ───────────────────────────────────────────────────────────────────
# REQUIRED: URL of the NestJS API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Admin token ──────────────────────────────────────────────────────────────
# Must match the API's ADMIN_API_TOKEN env var exactly.
# Generate with: openssl rand -base64 32
ADMIN_API_TOKEN=change-me-admin-token-min-16-chars
