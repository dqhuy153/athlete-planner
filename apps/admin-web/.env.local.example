# apps/admin-web — Copy to .env.local and fill in values

# ─── Public ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001        # REQUIRED: URL of the NestJS API

# ─── Admin token (stored in localStorage session, not used server-side here) ─
ADMIN_API_TOKEN=change-me-admin-token            # Must match API's ADMIN_API_TOKEN
