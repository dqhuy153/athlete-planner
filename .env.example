# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-super-secret-key

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_API_TOKEN=change-me-admin-token
ROOT_ADMIN_EMAIL=root@example.com
ROOT_ADMIN_PASSWORD=Admin@!1

# ─── Storage (Cloudflare R2 / MinIO) ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=app-assets
R2_PUBLIC_URL=http://localhost:9000/app-assets
# For dev with MinIO:
R2_ENDPOINT=http://localhost:9000

# ─── Cloudinary (optional alternative storage) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=app/assets

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=App <noreply@yourdomain.com>

# ─── Payments (PayOS) ────────────────────────────────────────────────────────
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
BANK_BIN=970422
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=YOUR APP NAME

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
FRONTEND_URL=http://localhost:3000

# ─── Next Auth (apps/web) ─────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
