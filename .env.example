# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used by apps/api (NestJS)
# Copy to .env and fill in the values.
# REQUIRED variables will cause the API to refuse startup if absent.
#
# For local dev without real Google/PayOS credentials:
#   set placeholder values (e.g. "dev-placeholder") — the app will start
#   but OAuth login and payments will not work until real values are provided.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string.
# Local dev: matches docker-compose.yml (port 5442 to avoid conflicts)
DATABASE_URL=postgresql://appuser:apppassword@localhost:5442/appdb

# ─── Redis ───────────────────────────────────────────────────────────────────
# Used by BullMQ cron jobs. Either set REDIS_URL or HOST+PORT.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-super-secret-key-min-32-chars

# REQUIRED. From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# See docs/deployment.md for step-by-step Google OAuth setup.
GOOGLE_CLIENT_ID=dev-placeholder
GOOGLE_CLIENT_SECRET=dev-placeholder

# ─── Admin ───────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 32
ADMIN_API_TOKEN=change-me-admin-token-min-16-chars

# REQUIRED. Email of the root admin user (created on first run).
ROOT_ADMIN_EMAIL=root@example.com
# Optional. Only used for seeding.
ROOT_ADMIN_PASSWORD=Admin@!1

# ─── CORS / URLs ─────────────────────────────────────────────────────────────
# REQUIRED. Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# REQUIRED. Primary web app URL (used in payment return URLs, email links).
FRONTEND_URL=http://localhost:3000

# ─── Storage: Cloudflare R2 / MinIO ──────────────────────────────────────────
# REQUIRED. Local dev uses MinIO (started via docker-compose up -d).
# Console: http://localhost:9001  user: minioadmin  pass: minioadmin
# See docs/deployment.md for Cloudflare R2 production setup.
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=app-assets
R2_PUBLIC_URL=http://localhost:9000/app-assets
R2_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=

# ─── Storage: Cloudinary (optional alternative) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=app/assets

# ─── AI (admin content generation) ───────────────────────────────────────────
# Optional. Required only for admin exercise content generation feature.
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=  # Disabled — using OpenRouter instead
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=

# ─── Payments: PayOS ─────────────────────────────────────────────────────────
# REQUIRED (API will refuse startup). Get from: https://my.payos.vn/
# See docs/deployment.md for PayOS registration steps.
PAYOS_CLIENT_ID=dev-placeholder
PAYOS_API_KEY=dev-placeholder
PAYOS_CHECKSUM_KEY=dev-placeholder
BANK_BIN=970422
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=YOUR APP NAME

# ─── Email: Resend ───────────────────────────────────────────────────────────
# Optional. Get from: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=App <noreply@yourdomain.com>

# ─────────────────────────────────────────────────────────────────────────────
# The following are read by Next.js apps (declared here so docker/CI can
# source a single file). They are NOT validated by the API's Joi schema.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret-min-16-chars
