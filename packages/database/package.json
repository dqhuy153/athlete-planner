{
  "name": "@athlete-planner/database",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Prisma schema and generated client for the monorepo",
  "scripts": {
    "build": "tsc",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@nestjs/common": "^11.0.0",
    "dotenv": "^16.5.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
}
