{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../packages/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "target": "ES2020"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
